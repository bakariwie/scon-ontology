    <rdfs:label xml:lang="en">risk level</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity expressing an ordinal level of assessed risk (low, moderate, high, imminent).</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
