    <rdfs:label xml:lang="en">lesson plan</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity specifying the objectives, content, and activities of a lesson.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
