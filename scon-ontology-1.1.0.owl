  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskLevel"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has risk level</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#assignedTier"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">assigned tier</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#partOfTrajectory"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">part of trajectory</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasGradePointAverageValue"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has grade point average value</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasAttendanceRateValue"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has attendance rate value</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskScore"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has risk score</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasSeverityLevel"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has severity level</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasISCEDLevel"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has i s c e d level</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#isRiskIndicatorOf"><owl:inverseOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskIndicator"/><rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RiskIndicator"/><rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:label xml:lang="en">is risk indicator of</rdfs:label><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRecommendedIntervention"><owl:inverseOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#recommendedFor"/><rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Intervention"/><rdfs:label xml:lang="en">has recommended intervention</rdfs:label><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance></owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasStudentRiskLevel"><owl:propertyChainAxiom rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskIndicator"/><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskLevel"/></owl:propertyChainAxiom><rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RiskLevel"/><rdfs:label xml:lang="en">has student risk level</rdfs:label><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance></owl:ObjectProperty>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AtRiskStudent"><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskIndicator"/><owl:someValuesFrom rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RiskIndicator"/></owl:Restriction></owl:intersectionOf>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance>
  </owl:Class></owl:equivalentClass><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:label xml:lang="en">at-risk student</rdfs:label><obo:IAO_0000115 xml:lang="en">A student who bears at least one risk indicator.</obo:IAO_0000115><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance></owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ChronicallyAbsentStudent"><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskIndicator"/><owl:someValuesFrom rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ChronicAbsence"/></owl:Restriction></owl:intersectionOf>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance>
  </owl:Class></owl:equivalentClass><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:label xml:lang="en">chronically absent student</rdfs:label><obo:IAO_0000115 xml:lang="en">A student who bears a chronic-absence risk indicator.</obo:IAO_0000115><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance></owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#HighRiskStudent"><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskIndicator"/><owl:someValuesFrom><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasRiskLevel"/><owl:hasValue rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#riskLevel_high"/></owl:Restriction></owl:someValuesFrom></owl:Restriction></owl:intersectionOf>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance>
  </owl:Class></owl:equivalentClass><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:label xml:lang="en">high-risk student</rdfs:label><obo:IAO_0000115 xml:lang="en">A student who bears a risk indicator whose assigned risk level is high.</obo:IAO_0000115><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance></owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentReceivingTieredSupport"><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#assignedTier"/><owl:someValuesFrom rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#MTSSTier"/></owl:Restriction></owl:intersectionOf>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance>
  </owl:Class></owl:equivalentClass><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/><rdfs:label xml:lang="en">student receiving tiered support</rdfs:label><obo:IAO_0000115 xml:lang="en">A student who has been assigned a multi-tiered system of supports tier.</obo:IAO_0000115><scon:module>risk-safeguarding</scon:module><scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance></owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RecommendedIntervention"><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Intervention"/><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#recommendedFor"/><owl:someValuesFrom rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/></owl:Restriction></owl:intersectionOf>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance>
  </owl:Class></owl:equivalentClass><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Intervention"/><rdfs:label xml:lang="en">recommended intervention</rdfs:label><obo:IAO_0000115 xml:lang="en">An intervention that is recommended for at least one student.</obo:IAO_0000115><scon:module>core</scon:module><scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance></owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#KnowledgeGroundedCounsellingSystem"><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/><owl:Restriction><owl:onProperty rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#groundedInKB"/><owl:someValuesFrom rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingKnowledgeBase"/></owl:Restriction></owl:intersectionOf>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance>
  </owl:Class></owl:equivalentClass><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/><rdfs:label xml:lang="en">knowledge-grounded counselling system</rdfs:label><obo:IAO_0000115 xml:lang="en">An intelligent counselling system whose outputs are grounded in a counselling knowledge base.</obo:IAO_0000115><scon:module>intelligent-systems</scon:module><scon:populationProvenance>author-vocabulary (defined class, v1.1.0)</scon:populationProvenance></owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AttendanceRiskIndicator">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RiskIndicator"/>
    <rdfs:label>attendance risk indicator</rdfs:label>
    <obo:IAO_0000115>A risk indicator whose evidence is a pattern of school or class attendance falling below an institutionally defined threshold.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskIndicator">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RiskIndicator"/>
    <rdfs:label>behavioural risk indicator</rdfs:label>
    <obo:IAO_0000115>A risk indicator whose evidence is a recorded pattern of conduct, such as repeated discipline referrals, rather than an academic or socio-emotional measure.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialNeedAssessment">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Assessment"/>
    <rdfs:label>financial need assessment</rdfs:label>
    <obo:IAO_0000115>An assessment that determines the extent to which a student's cost of attendance exceeds the resources available to that student, and which is about the student rather than borne by the student.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialAidAward">
    <rdfs:label>financial aid award</rdfs:label>
    <obo:IAO_0000115>An information content entity recording a grant of financial support made to a student for the purpose of meeting an assessed financial need.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ScholarshipAward">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialAidAward"/>
    <rdfs:label>scholarship award</rdfs:label>
    <obo:IAO_0000115>A financial aid award made on the basis of merit, need, or both, and which the recipient is not required to repay.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#WorkStudyAward">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialAidAward"/>
    <rdfs:label>work-study award</rdfs:label>
    <obo:IAO_0000115>A financial aid award that provides paid institutional employment to a student, discharged through hours worked rather than through a cash transfer.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentLoanAward">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialAidAward"/>
    <rdfs:label>student loan award</rdfs:label>
    <obo:IAO_0000115>A financial aid award that the recipient is obliged to repay, whether to the institution or to an external lender.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialIntervention">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Intervention"/>
    <rdfs:label>financial intervention</rdfs:label>
    <obo:IAO_0000115>An intervention whose objective is to reduce a student's assessed unmet financial need, for example by securing a bursary or by developing budgeting capability.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EmotionalIntelligenceAssessment">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PsychologicalAssessment"/>
    <rdfs:label>emotional intelligence assessment</rdfs:label>
    <rdfs:seeAlso>Wong and Law Emotional Intelligence Scale (WLEIS)</rdfs:seeAlso>
    <obo:IAO_0000115>A psychological assessment that administers a standardised emotional intelligence instrument and reports subscale scores for the appraisal, use and regulation of emotion.</obo:IAO_0000115>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SuicideRiskScreening">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SuicideRiskAssessment"/>
    <rdfs:label>suicide risk screening</rdfs:label>
    <rdfs:seeAlso>Columbia-Suicide Severity Rating Scale (C-SSRS)</rdfs:seeAlso>
    <obo:IAO_0000115>A single administration of a standardised suicide-risk screening instrument, recording only the published ordinal severity category reached and never any narrative disclosure.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SelfManagementIntervention">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalIntervention"/>
    <rdfs:label>self-management intervention</rdfs:label>
    <obo:IAO_0000115>A social-emotional intervention directed at a student's capacity to regulate attention, emotion and conduct, as distinct from one directed at relationships or at academic strategy.</obo:IAO_0000115>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#TutoringService">
    <rdfs:label>tutoring service</rdfs:label>
    <obo:IAO_0000115>An institutional or external service that provides supplementary subject-matter instruction, and to which a student may be referred following an identified academic concern.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SpecialEducationEvaluation">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Assessment"/>
    <rdfs:label>special education evaluation</rdfs:label>
    <obo:IAO_0000115>A formal evaluation undertaken to determine whether a student qualifies for special educational provision, and which is initiated by referral rather than by routine screening.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CrisisEvent">
    <rdfs:label>crisis event</rdfs:label>
    <obo:IAO_0000115>An occurrence that places a student, a cohort or an institution in acute jeopardy and that activates a crisis response, as distinguished from the response process itself.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#InstitutionalRole">
    <rdfs:label>institutional role</rdfs:label>
    <obo:IAO_0000115>A role borne by a person in virtue of a position held within an educational institution, and which determines that person's part in a defined procedure.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerReadinessGap">
    <rdfs:label>career readiness gap</rdfs:label>
    <obo:IAO_0000115>The shortfall between the career-related competencies a student has demonstrated and those expected at that student's stage of progression.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ApplicationMilestone">
    <rdfs:label>application milestone</rdfs:label>
    <obo:IAO_0000115>A dated checkpoint in a postsecondary, employment or funding application process, against which a student's completion or omission is recorded.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicProgramme">
    <rdfs:label>academic programme</rdfs:label>
    <obo:IAO_0000115>A structured course of study offered by an academic department and leading to a named award.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicStanding">
    <rdfs:label>academic standing</rdfs:label>
    <obo:IAO_0000115>The status conferred on a student by an institution on the basis of cumulative academic performance, and which governs progression and eligibility.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#GoodStanding">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicStanding"/>
    <rdfs:label>good standing</rdfs:label>
    <obo:IAO_0000115>An academic standing indicating that a student meets all progression requirements without condition.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#DeansListStanding">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicStanding"/>
    <rdfs:label>dean's list standing</rdfs:label>
    <obo:IAO_0000115>An academic standing conferred in recognition of cumulative performance above an institutionally defined distinction threshold.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ProbationStanding">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicStanding"/>
    <rdfs:label>probation standing</rdfs:label>
    <obo:IAO_0000115>An academic standing indicating that cumulative performance has fallen below the progression threshold, and which imposes conditions on continued enrolment.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ResearchInterestArea">
    <rdfs:label>research interest area</rdfs:label>
    <obo:IAO_0000115>A field of enquiry that a student has declared an intention to pursue, and which informs supervision and project allocation.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CapstoneProject">
    <rdfs:label>capstone project</rdfs:label>
    <obo:IAO_0000115>A culminating independent project undertaken in the final stage of a programme and supervised by a member of academic staff.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#TechInternship">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Internship"/>
    <rdfs:label>technology sector internship</rdfs:label>
    <obo:IAO_0000115>An internship undertaken with an employer in the information and communications technology sector.</obo:IAO_0000115>
    <scon:module>higher-education</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasAcademicStanding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicStanding"/>
    <rdfs:label>has academic standing</rdfs:label>
    <obo:IAO_0000115>Relates a student to the academic standing currently conferred on that student.</obo:IAO_0000115>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasResearchInterest">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ResearchInterestArea"/>
    <rdfs:label>has research interest</rdfs:label>
    <obo:IAO_0000115>Relates a student to a field of enquiry that the student has declared an intention to pursue.</obo:IAO_0000115>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#worksOnProject">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CapstoneProject"/>
    <rdfs:label>works on project</rdfs:label>
    <obo:IAO_0000115>Relates a student to a capstone project the student is undertaking.</obo:IAO_0000115>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#receivesAward">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialAidAward"/>
    <rdfs:label>receives award</rdfs:label>
    <obo:IAO_0000115>Relates a student to a financial aid award granted to that student.</obo:IAO_0000115>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasIncomeBracketValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialNeedAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>has income bracket value</rdfs:label>
    <obo:IAO_0000115>An ordinal household income band from 1, the lowest quintile, to 5, the highest, recorded by a financial need assessment.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasEFCAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialNeedAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has expected family contribution amount</rdfs:label>
    <obo:IAO_0000115>The amount a student's family is assessed as able to contribute towards the cost of attendance.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasUnmetNeedAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialNeedAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has unmet financial need amount</rdfs:label>
    <obo:IAO_0000115>The residual amount by which cost of attendance exceeds all assessed contributions and awards.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasWorkStudyHours">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialNeedAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has work-study hours per week</rdfs:label>
    <obo:IAO_0000115>The number of hours per week of institutional paid employment recorded against a financial need assessment.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasAwardAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FinancialAidAward"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has award amount</rdfs:label>
    <obo:IAO_0000115>The monetary value of a financial aid award.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasIdeationLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SuicideRiskScreening"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>has ideation level</rdfs:label>
    <obo:IAO_0000115>The ordinal category reached on the ideation subscale of a standardised suicide-risk screening instrument: 0 no ideation, 1 wish to be dead, 2 non-specific active thoughts, 3 active ideation with method, 4 active ideation with plan or intent.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasSelfEmotionAppraisalScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EmotionalIntelligenceAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has self emotion appraisal score</rdfs:label>
    <obo:IAO_0000115>The subscale score for a person's appraisal and expression of their own emotion.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasOthersEmotionAppraisalScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EmotionalIntelligenceAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has others emotion appraisal score</rdfs:label>
    <obo:IAO_0000115>The subscale score for a person's appraisal and recognition of emotion in others.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasUseOfEmotionScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EmotionalIntelligenceAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has use of emotion score</rdfs:label>
    <obo:IAO_0000115>The subscale score for a person's use of emotion to facilitate performance.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasEmotionRegulationScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EmotionalIntelligenceAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has emotion regulation score</rdfs:label>
    <obo:IAO_0000115>The subscale score for a person's regulation of their own emotion.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasOpennessScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PersonalityInventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has openness score</rdfs:label>
    <obo:IAO_0000115>The openness-to-experience factor score reported by a five-factor personality inventory.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasConscientiousnessScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PersonalityInventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has conscientiousness score</rdfs:label>
    <obo:IAO_0000115>The conscientiousness factor score reported by a five-factor personality inventory.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasExtraversionScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PersonalityInventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has extraversion score</rdfs:label>
    <obo:IAO_0000115>The extraversion factor score reported by a five-factor personality inventory.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasAgreeablenessScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PersonalityInventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has agreeableness score</rdfs:label>
    <obo:IAO_0000115>The agreeableness factor score reported by a five-factor personality inventory.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#hasNeuroticismScore">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PersonalityInventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has neuroticism score</rdfs:label>
    <obo:IAO_0000115>The neuroticism factor score reported by a five-factor personality inventory.</obo:IAO_0000115>
  </owl:DatatypeProperty>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#tier1_universal">
    <rdf:type rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#TierOneSupport"/>
    <rdfs:label>Tier 1 universal support</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#tier3_intensive">
    <rdf:type rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#TierThreeSupport"/>
    <rdfs:label>Tier 3 intensive support</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#domain_academic">
    <rdf:type rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicDevelopment"/>
    <rdfs:label>academic developmental domain</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#domain_career">
    <rdf:type rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDevelopment"/>
    <rdfs:label>career developmental domain</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#domain_socialEmotional">
    <rdf:type rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalDevelopment"/>
    <rdfs:label>social and emotional developmental domain</rdfs:label>
  </owl:NamedIndividual>

</rdf:RDF>