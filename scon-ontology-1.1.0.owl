  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">software application</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity constituting a program that performs functions for a user or another program.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">intelligent counselling system</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software system that supports or delivers counselling functions using artificial-intelligence techniques over the SCON knowledge base; the class of systems SCON is engineered to support.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#LargeLanguageModel">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">large language model</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A generative language model used, under governance, for ontology population, dialogue, and explanation within intelligent counselling systems.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#NaturalLanguageUnderstandingComponent">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">natural language understanding component</rdfs:label><obo:IAO_0000115 xml:lang="en">A software application that interprets human-language input for an intelligent counselling system.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#DialogueManager">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">dialogue manager</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software component that controls the flow of a dialogue interaction.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntentClassifier">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">intent classifier</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software component that assigns a user intent to an utterance.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SentimentAnalyser">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">sentiment analyser</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software component that estimates the sentiment polarity of a text.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EmotionRecognitionComponent">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">emotion recognition component</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software component that infers emotion processes from text, speech, or other signals.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SafetyGuardrail">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SoftwareApplication"/>
    <rdfs:label xml:lang="en">safety guardrail</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A directive software component constraining system outputs to safe, policy-compliant behaviour, including crisis escalation to a human counsellor.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingChatbot">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/>
    <rdfs:label xml:lang="en">counselling chatbot</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An intelligent counselling system that interacts with users through natural-language dialogue.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ConversationalAgent">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/>
    <rdfs:label xml:lang="en">conversational agent</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software agent capable of multi-turn natural-language interaction.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#VirtualCounsellingAssistant">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/>
    <rdfs:label xml:lang="en">virtual counselling assistant</rdfs:label><obo:IAO_0000115 xml:lang="en">An intelligent counselling system that interacts conversationally with students to provide counselling-related support.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RecommenderSystem">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/>
    <rdfs:label xml:lang="en">recommender system</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software system that generates ranked suggestions (e.g., interventions, pathways, resources) for a user.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#DecisionSupportSystem">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/>
    <rdfs:label xml:lang="en">decision support system</rdfs:label><obo:IAO_0000115 xml:lang="en">An intelligent counselling system that assists human counsellors by analysing data and suggesting options.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EarlyWarningSystem">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntelligentCounsellingSystem"/>
    <rdfs:label xml:lang="en">early warning system</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A software system that monitors indicators to flag students at risk in time for intervention.</obo:IAO_0000115>
    <scon:module>intelligent-systems</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
    <rdfs:label xml:lang="en">counselling process</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A planned process conducted or coordinated by a counselling professional or intelligent counselling system for the benefit of one or more students.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingSession">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">counselling session</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A temporally bounded counselling process in which a counsellor (or system) and one or more students participate.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Intervention">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">intervention</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A counselling process that addresses at least one student issue (axiom: Intervention subClassOf addresses some StudentIssue).</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Assessment">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">assessment</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A counselling process applying an instrument or criterion set to evaluate a student's academic, psychosocial, behavioural, or career state.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Referral">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">referral</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A counselling process transferring or escalating responsibility for a concern within the MTSS or to an external agency.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ProgressMonitoring">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">progress monitoring</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which a student's progress toward goals is tracked over time.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ClassroomInstruction">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">classroom instruction</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which a counsellor delivers developmental curriculum to a class of students as Tier 1 support.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IntakeInterview">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">intake interview</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which initial information is gathered to establish a student's needs and goals.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ExitInterview">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">exit interview</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process conducted when a student leaves a programme or institution to gather information and provide closure.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FollowUpSession">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">follow up session</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process conducted after an intervention to review progress and adjust support.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicAdvising">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">academic advising</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which an advisor guides a student's course selection, academic planning, and progress.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#MentoringProcess">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">mentoring process</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which a more experienced person supports a student's development over time.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#OrientationProgramme">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">orientation programme</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process that introduces new students to an institution and its expectations and services.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PsychoeducationalWorkshop">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">psychoeducational workshop</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process that delivers structured educational content on psychological or developmental topics to students.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#WellnessCheckIn">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">wellness check in</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process consisting of a brief contact to monitor a student's wellbeing.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SafetyPlanning">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">safety planning</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which a counsellor and student collaboratively develop steps to keep the student safe.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#MandatedReporting">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">mandated reporting</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A process, required by law or policy, of reporting a safeguarding concern to a designated authority.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CrisisResponse">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">crisis response</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A counselling process activated by a crisis, following defined procedures and roles.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CaseDocumentation">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingProcess"/>
    <rdfs:label xml:lang="en">case documentation</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling process in which a counsellor records information about a student's case.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#IndividualCounselling">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingSession"/>
    <rdfs:label xml:lang="en">individual counselling</rdfs:label><obo:IAO_0000115 xml:lang="en">A counselling session delivered one-to-one between a counsellor and a single student.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
