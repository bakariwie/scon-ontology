    <rdfs:label xml:lang="en">financial hardship indicator</rdfs:label><obo:IAO_0000115 xml:lang="en">A risk indicator signalling that financial difficulty may threaten a student's continuation.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
