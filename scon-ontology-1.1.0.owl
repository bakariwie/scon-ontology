    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">counselling plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing the goals and activities of a student's counselling.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PostsecondaryPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">postsecondary plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing a student's intended education or training after secondary school.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ClosingTheGapActionPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">closing the gap action plan</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An ASCA action plan targeting an identified equity gap for a defined student group, with results reporting.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AnnualStudentOutcomeGoal">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">annual student outcome goal</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An ASCA programme goal stating targeted improvement in achievement, attendance, or discipline for a student group within a year.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
