    <rdfs:label xml:lang="en">directive information entity</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity that prescribes or guides action.</obo:IAO_0000115>
    <scon:module>governance</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingGuideline">
