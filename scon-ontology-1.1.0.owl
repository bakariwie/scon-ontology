    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Employability">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDisposition"/>
    <rdfs:label xml:lang="en">employability</rdfs:label><obo:IAO_0000115 xml:lang="en">A career disposition constituting the attributes and competencies that make a student capable of gaining and sustaining employment.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ProfessionalEthics">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDisposition"/>
    <rdfs:label xml:lang="en">professional ethics</rdfs:label><obo:IAO_0000115 xml:lang="en">A career disposition constituting a student's commitment to the ethical standards of a profession or workplace.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#WorkReadiness">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDisposition"/>
    <rdfs:label xml:lang="en">work readiness</rdfs:label><obo:IAO_0000115 xml:lang="en">A career disposition constituting a student's preparedness to meet the demands and expectations of employment.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Aptitude">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDisposition"/>
    <rdfs:label xml:lang="en">aptitude</rdfs:label><obo:IAO_0000115 xml:lang="en">A career disposition constituting a student's natural or developed capacity to learn or perform in a given domain of activity.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#WorkValue">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDisposition"/>
    <rdfs:label xml:lang="en">work value</rdfs:label><obo:IAO_0000115 xml:lang="en">A career disposition constituting the relative importance a student places on particular attributes of work, such as autonomy, security, or service.</obo:IAO_0000115>
    <scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Aggression">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">aggression</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition inclining a student toward hostile or harmful action toward others.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#TruancyTendency">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">truancy tendency</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition inclining a student toward unauthorised absence from school.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SubstanceAbuseRisk">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">substance abuse risk</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition constituting an elevated proneness to harmful use of substances.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BullyingTendency">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">bullying tendency</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition inclining a student to intimidate or harm peers repeatedly.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AnxietyVulnerability">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">anxiety vulnerability</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition constituting a heightened proneness to anxiety.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#DepressionVulnerability">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">depression vulnerability</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition constituting a heightened proneness to depression.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SuicidalIdeationRisk">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviouralRiskDisposition"/>
    <rdfs:label xml:lang="en">suicidal ideation risk</rdfs:label><obo:IAO_0000115 xml:lang="en">A behavioural risk disposition constituting an elevated proneness to thoughts of suicide.</obo:IAO_0000115>
    <scon:module>risk-safeguarding</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Skill">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    <rdfs:label xml:lang="en">skill</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A realizable entity (disposition) to perform a task at a defined level; aligned to esco:Skill and educor:Skill.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">ESCO; EduCOR</dcterms:source>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/esco/model#Skill"/>
    <rdfs:seeAlso rdf:resource="https://github.com/tibonto/educor#Skill"/>
    <scon:module>career</scon:module>
    <scon:populationProvenance>reused-vocabulary (ESCO; DOMASEC)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Competency">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    <rdfs:label xml:lang="en">competency</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A disposition integrating knowledge, skills, and attitudes enabling adequate performance in a context (DOMASEC-aligned).</obo:IAO_0000115>
    <dcterms:source xml:lang="en">DOMASEC taxonomy</dcterms:source>
    <scon:module>career</scon:module>
    <scon:populationProvenance>reused-vocabulary (ESCO; DOMASEC)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalCompetency">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Competency"/>
    <rdfs:label xml:lang="en">social emotional competency</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A competency in the social-emotional domain; the five CASEL competencies specialise this class.</obo:IAO_0000115>
    <rdfs:seeAlso rdf:resource="https://casel.org/"/>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>reused-vocabulary (CASEL)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SelfAwareness">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalCompetency"/>
    <rdfs:label xml:lang="en">self awareness</rdfs:label><obo:IAO_0000115 xml:lang="en">A CASEL social-emotional competency for understanding one's own emotions, thoughts, and values.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">CASEL framework</dcterms:source>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>reused-vocabulary (CASEL)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SelfManagement">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalCompetency"/>
    <rdfs:label xml:lang="en">self management</rdfs:label><obo:IAO_0000115 xml:lang="en">A CASEL social-emotional competency for regulating one's emotions, thoughts, and behaviours across situations.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">CASEL framework</dcterms:source>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>reused-vocabulary (CASEL)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialAwareness">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalCompetency"/>
    <rdfs:label xml:lang="en">social awareness</rdfs:label><obo:IAO_0000115 xml:lang="en">A CASEL social-emotional competency for taking the perspective of and empathising with others.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">CASEL framework</dcterms:source>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>reused-vocabulary (CASEL)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RelationshipSkills">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalCompetency"/>
    <rdfs:label xml:lang="en">relationship skills</rdfs:label><obo:IAO_0000115 xml:lang="en">A CASEL social-emotional competency for establishing and maintaining healthy and rewarding relationships.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">CASEL framework</dcterms:source>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>reused-vocabulary (CASEL)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ResponsibleDecisionMaking">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalCompetency"/>
    <rdfs:label xml:lang="en">responsible decision making</rdfs:label><obo:IAO_0000115 xml:lang="en">A CASEL social-emotional competency for making constructive choices about personal behaviour and social interactions.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">CASEL framework</dcterms:source>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>reused-vocabulary (CASEL)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentIssue">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    <rdfs:label xml:lang="en">student issue</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A disposition borne by a student - a presenting concern or developmental need - realised in observable difficulties and addressed by interventions.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentIssue"/>
    <rdfs:label xml:lang="en">academic issue</rdfs:label><obo:IAO_0000115 xml:lang="en">A student issue concerning a student's academic functioning or progress.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerIndecision">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentIssue"/>
    <rdfs:label xml:lang="en">career indecision</rdfs:label><obo:IAO_0000115 xml:lang="en">A student issue constituting a student's inability to commit to a career or educational direction.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalIssue">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentIssue"/>
    <rdfs:label xml:lang="en">social emotional issue</rdfs:label><obo:IAO_0000115 xml:lang="en">A student issue concerning a student's social or emotional functioning.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SafeguardingConcern">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentIssue"/>
    <rdfs:label xml:lang="en">safeguarding concern</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A student issue whose nature or severity triggers mandated safeguarding action and referral.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicUnderachievement">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue"/>
    <rdfs:label xml:lang="en">academic underachievement</rdfs:label><obo:IAO_0000115 xml:lang="en">An academic issue in which a student's demonstrated attainment falls persistently below their assessed potential or expected level.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CourseFailure">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue"/>
    <rdfs:label xml:lang="en">course failure</rdfs:label><obo:IAO_0000115 xml:lang="en">An academic issue in which a student does not attain the passing standard for one or more courses.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudySkillsDeficit">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue"/>
    <rdfs:label xml:lang="en">study skills deficit</rdfs:label><obo:IAO_0000115 xml:lang="en">An academic issue constituting an inadequacy in the study strategies a student needs for effective learning.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicProbation">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue"/>
    <rdfs:label xml:lang="en">academic probation</rdfs:label><obo:IAO_0000115 xml:lang="en">An academic issue in which a student is placed under conditional status for failing to meet minimum academic-performance standards.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#RetentionRisk">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue"/>
    <rdfs:label xml:lang="en">retention risk</rdfs:label><obo:IAO_0000115 xml:lang="en">An academic issue constituting an elevated likelihood that a student will be required to repeat a grade or year.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#DropoutRisk">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicIssue"/>
    <rdfs:label xml:lang="en">dropout risk</rdfs:label><obo:IAO_0000115 xml:lang="en">An academic issue constituting an elevated likelihood that a student will leave education before completing their programme.</obo:IAO_0000115>
    <scon:module>academic</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#MentalHealthConcern">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalIssue"/>
    <rdfs:label xml:lang="en">mental health concern</rdfs:label><obo:IAO_0000115 xml:lang="en">A social-emotional issue concerning a student's mental health.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">DSM-5-TR / SNOMED CT (controlled vocabulary alignment only)</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://www.snomed.org/"/>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AdjustmentDifficulty">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalIssue"/>
    <rdfs:label xml:lang="en">adjustment difficulty</rdfs:label><obo:IAO_0000115 xml:lang="en">A social-emotional issue constituting difficulty adapting to new circumstances, such as a new institution.</obo:IAO_0000115>
    <scon:module>social-emotional</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Homesickness">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalIssue"/>
    <rdfs:label xml:lang="en">homesickness</rdfs:label><obo:IAO_0000115 xml:lang="en">A social-emotional issue constituting distress caused by separation from home.</obo:IAO_0000115>
    <scon:module>social-emotional</scon:module>
