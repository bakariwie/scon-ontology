    <rdfs:label xml:lang="en">agreeableness</rdfs:label><obo:IAO_0000115 xml:lang="en">A personality trait, in the Big Five taxonomy, characterising a tendency toward compassion and cooperation.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">Big Five taxonomy</dcterms:source>
