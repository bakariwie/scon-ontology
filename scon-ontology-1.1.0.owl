    <rdfs:label xml:lang="en">vision statement</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity declaring the desired future state a counselling programme aspires to achieve.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#MissionStatement">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">mission statement</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity declaring the purpose of a counselling programme or institution.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
