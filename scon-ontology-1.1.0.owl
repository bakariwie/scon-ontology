    <rdfs:label xml:lang="en">chronic absence</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An academic risk indicator recording that a student's absence rate exceeds the institutional chronic-absence threshold.</obo:IAO_0000115>
