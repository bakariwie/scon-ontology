  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingDomain"><rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/><rdfs:label xml:lang="en">counselling domain</rdfs:label><obo:IAO_0000115 xml:lang="en">One of the developmental domains of the ASCA National Model.</obo:IAO_0000115><scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicDevelopment"><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingDomain"/><rdfs:label xml:lang="en">academic development</rdfs:label><obo:IAO_0000115 xml:lang="en">The ASCA developmental domain concerned with a student's acquisition of the attitudes, knowledge, and skills that support effective learning and academic achievement.</obo:IAO_0000115><scon:module>academic</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDevelopment"><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingDomain"/><rdfs:label xml:lang="en">career development</rdfs:label><obo:IAO_0000115 xml:lang="en">The ASCA developmental domain concerned with a student's acquisition of the attitudes, knowledge, and skills to make informed career and postsecondary decisions and transitions.</obo:IAO_0000115><scon:module>career</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalDevelopment"><rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CounsellingDomain"/><rdfs:label xml:lang="en">social-emotional development</rdfs:label><obo:IAO_0000115 xml:lang="en">The ASCA developmental domain concerned with a student's acquisition of the attitudes, knowledge, and skills to understand and manage emotions and maintain positive relationships.</obo:IAO_0000115><scon:module>social-emotional</scon:module>
    <scon:populationProvenance>author-vocabulary (v1.1.0)</scon:populationProvenance>
  </owl:Class>
  <rdf:Description><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/><owl:members rdf:parseType="Collection"><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicDevelopment"/><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDevelopment"/><rdf:Description rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SocialEmotionalDevelopment"/></owl:members></rdf:Description>

  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Person">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
    <rdfs:label xml:lang="en">person</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A material entity that is an individual human being.</obo:IAO_0000115>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/Person"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Student">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Person"/>
    <rdfs:label xml:lang="en">student</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A person enrolled in an educational institution who bears a student role and is the primary beneficiary of counselling across the academic, career, and social-emotional domains (ASCA).</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Counsellor">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Person"/>
    <rdfs:label xml:lang="en">counsellor</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A person who bears a counselling-provider role and delivers counselling services.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicAdvisor">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Person"/>
    <rdfs:label xml:lang="en">academic advisor</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A professional who guides students on programme selection, course planning, and academic progression.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerAdvisor">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Person"/>
    <rdfs:label xml:lang="en">career advisor</rdfs:label><obo:IAO_0000115 xml:lang="en">A person who advises students on career and postsecondary decisions.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Teacher">
