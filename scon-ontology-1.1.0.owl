    <rdfs:label xml:lang="en">counselling record</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity documenting counselling processes concerning a student; access is governed by consent and confidentiality (S-CQ7).</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
