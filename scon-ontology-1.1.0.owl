    <rdfs:label xml:lang="en">MTSS tier</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity that designates a level of support intensity within a multi-tiered system of supports.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
