    <rdfs:label xml:lang="en">mindsets behaviors standard</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">One of the ASCA Student Standards: Mindsets and Behaviors for Student Success, applied across the three domains.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
