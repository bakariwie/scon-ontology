    <rdfs:label xml:lang="en">career cluster</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A grouping of related occupations and industries used for career exploration (O*NET/advance-CTE usage).</obo:IAO_0000115>
    <dcterms:source xml:lang="en">O*NET Content Model</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://www.onetcenter.org/content.html"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ProgrammeOfStudy">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">programme of study</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity specifying a structured curriculum leading to a qualification (ISCED-classifiable).</obo:IAO_0000115>
    <dcterms:source xml:lang="en">ISCED (UNESCO)</dcterms:source>
    <rdfs:seeAlso rdf:resource="http://uis.unesco.org/en/topic/international-standard-classification-education-isced"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Course">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">course</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity specifying a unit of teaching within a programme of study; cf. schema:Course.</obo:IAO_0000115>
    <rdfs:seeAlso rdf:resource="https://schema.org/Course"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Curriculum">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">curriculum</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity specifying the planned content and organisation of a course of study.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#LearningResource">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">learning resource</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity used to support student learning.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">IEEE LOM; EduCOR</dcterms:source>
    <rdfs:seeAlso rdf:resource="https://schema.org/LearningResource"/>
    <rdfs:seeAlso rdf:resource="https://github.com/tibonto/educor#EducationalResource"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Qualification">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">qualification</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity certifying assessed learning outcomes; aligned to esco:Qualification and ISCED levels.</obo:IAO_0000115>
    <dcterms:source xml:lang="en">ESCO; ISCED</dcterms:source>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/esco/model#Qualification"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#EnrollmentRecord">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">enrollment record</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity that documents a student's enrolment status.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#GraduationRequirement">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">graduation requirement</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity specifying a condition a student must satisfy in order to graduate.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CoursePrerequisite">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">course prerequisite</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity specifying a course that must be completed before enrolling in another.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PromotionCriterion">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">promotion criterion</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity specifying a condition for a student's promotion to the next grade or level.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#UserProfile">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">user profile</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity describing a system user; interoperable with educor:UserProfile.</obo:IAO_0000115>
    <rdfs:seeAlso rdf:resource="https://github.com/tibonto/educor#UserProfile"/>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentModel">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">student model</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity maintained by an intelligent system representing a student's evolving state, preferences, and needs.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#Utterance">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">utterance</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity carrying a single contribution by a user or system within a dialogue.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#UserIntent">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">user intent</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity representing the communicative goal recognised from an utterance.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SystemResponse">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">system response</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity carrying the system's reply in a dialogue interaction, grounded in the counselling knowledge base.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CrisisDetectionAlert">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">crisis detection alert</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity emitted when risk detection identifies possible crisis-level content, triggering escalation to a human.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AuditLogEntry">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">audit log entry</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity recording an action performed on a counselling record, for accountability (S-CQ derived; CQ15 lineage).</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#LabourMarketInformation">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">labour market information</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity describing conditions, trends, and opportunities in the labour market.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ConsentCondition">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">consent condition</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity stating the consent under which counselling information may be collected, used, or disclosed.</obo:IAO_0000115>
    <scon:module>governance</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ConfidentialityConstraint">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">confidentiality constraint</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity restricting access to or disclosure of counselling information.</obo:IAO_0000115>
    <scon:module>governance</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#InformedConsent">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ConsentCondition"/>
    <rdfs:label xml:lang="en">informed consent</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A consent condition given voluntarily by a person with capacity, after disclosure of purpose, risks, and alternatives; in higher education the consenting party is normally the student.</obo:IAO_0000115>
    <scon:module>governance</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#GuardianConsent">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ConsentCondition"/>
    <rdfs:label xml:lang="en">guardian consent</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A consent condition provided by a parent or guardian on behalf of a minor student.</obo:IAO_0000115>
    <scon:module>governance</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#StudentSelfConsent">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#ConsentCondition"/>
    <rdfs:label xml:lang="en">student self consent</rdfs:label><obo:IAO_0000115 xml:lang="en">A consent condition in which a student who is legally competent consents on their own behalf, as in higher education.</obo:IAO_0000115>
    <scon:module>governance</scon:module>
    <scon:populationProvenance>llm-proposed-human-approved (Claude, Anthropic) - pending expert adjudication</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">plan specification</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A directive information content entity specifying intended actions, objectives, and conditions.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#InterventionPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">intervention plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing the interventions to be delivered to a student.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#AcademicImprovementPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">academic improvement plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing actions to improve a student's academic performance.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CareerDevelopmentPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">career development plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing steps toward a student's career goals.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#BehaviourInterventionPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">behaviour intervention plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing strategies to address a student's challenging behaviour.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#CrisisManagementPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">crisis management plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing procedures for responding to a crisis.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#FollowUpPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">follow up plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing follow-up actions after an intervention.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#SafetyPlan">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#PlanSpecification"/>
    <rdfs:label xml:lang="en">safety plan</rdfs:label><obo:IAO_0000115 xml:lang="en">A plan specification prescribing measures to maintain a student's safety.</obo:IAO_0000115>
    <scon:module>core</scon:module>
    <scon:populationProvenance>author-vocabulary (BFO Continuants and Occurrents inventory, 2026)</scon:populationProvenance>
  </owl:Class>
