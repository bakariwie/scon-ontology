    <rdfs:label xml:lang="en">career guidance pathway</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A plan-like information content entity specifying educational and vocational steps appropriate to a student's profile; interoperable with educor:LearningPath.</obo:IAO_0000115>
