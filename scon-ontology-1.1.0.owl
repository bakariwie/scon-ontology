    <rdfs:label xml:lang="en">AI recommendation</rdfs:label><obo:IAO_0000115 xml:lang="en">An information content entity constituting a suggested action or resource produced by an intelligent counselling system.</obo:IAO_0000115>
    <rdfs:seeAlso rdf:resource="https://github.com/tibonto/educor#Recommendation"/>
    <scon:module>core</scon:module>
