# S-CQ3 (Social-emotional domain)
# Competency question: How is the severity or urgency of a socio-emotional risk classified to prioritise response, including activation of suicide-risk protocols?
# Classes used: HighRiskStudent, SafeguardingConcern, SuicideRiskAssessment
# Properties used: concernsStudent, escalatesTo, hasStudentRiskLevel
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?riskLevel ?concern ?protocol
WHERE {
  ?student rdf:type scon:HighRiskStudent .
  ?student scon:hasStudentRiskLevel ?riskLevel .
  OPTIONAL { ?concern scon:concernsStudent ?student .
             ?concern rdf:type scon:SafeguardingConcern .
             ?concern scon:escalatesTo ?protocol .
             ?protocol rdf:type scon:SuicideRiskAssessment . }
}
ORDER BY ?student
