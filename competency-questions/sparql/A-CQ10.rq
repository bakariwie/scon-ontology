# A-CQ10 (Academic domain)
# Competency question: Which self-management skills (B-SMS) are associated with a student's academic engagement?
# Classes used: SelfManagementSkillsBehaviour, Student
# Properties used: developsSkill
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?skill ?skillLabel
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:developsSkill ?skill .
  ?skill rdf:type scon:SelfManagementSkillsBehaviour .
  ?skill rdfs:label ?skillLabel .
}
ORDER BY ?student
