# C-CQ7 (Career domain)
# Competency question: Which students lack a documented postsecondary plan by a milestone grade, as targeted by a closing-the-gap action plan?
# Classes used: PostsecondaryPlan, Student
# Properties used: hasGoal, hasGradeLevel
# NOTE: uses MINUS rather than FILTER NOT EXISTS, because the Protege
# Snap SPARQL parser accepts MINUS but not every FILTER sub-form.
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?grade
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:hasGradeLevel ?grade .
  FILTER (?grade = "Grade 11" || ?grade = "Grade 12"
          || ?grade = "Level 300" || ?grade = "Level 400")
  MINUS {
    ?student scon:hasGoal ?plan .
    ?plan rdf:type scon:PostsecondaryPlan .
  }
}
ORDER BY ?grade ?student
