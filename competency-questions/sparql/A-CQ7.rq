# A-CQ7 (Academic domain)
# Competency question: How does a student's academic record map to graduation requirements, promotion criteria, and course prerequisites?
# Classes used: GraduationRequirement, Student
# Properties used: prerequisiteOf, takesCourse
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?course ?prerequisite ?requirement ?requirementLabel
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:takesCourse ?course .
  OPTIONAL { ?prerequisite scon:prerequisiteOf ?course . }
  ?requirement rdf:type scon:GraduationRequirement .
  ?requirement rdfs:label ?requirementLabel .
}
ORDER BY ?student ?course
