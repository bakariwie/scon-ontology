# A-CQ12 (Academic domain)
# Competency question: Which academic interventions are duplicated within a student's current support plan, and how is this detected by the reasoner?
# Classes used: AcademicIntervention
# Properties used: addresses, recommendedFor
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?intervention1 ?intervention2 ?issue
WHERE {
  ?intervention1 rdf:type scon:AcademicIntervention .
  ?intervention2 rdf:type scon:AcademicIntervention .
  ?intervention1 scon:recommendedFor ?student .
  ?intervention2 scon:recommendedFor ?student .
  ?intervention1 scon:addresses ?issue .
  ?intervention2 scon:addresses ?issue .
  FILTER (?intervention1 != ?intervention2)
}
ORDER BY ?student
