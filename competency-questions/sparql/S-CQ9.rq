# S-CQ9 (Social-emotional domain)
# Competency question: How are a student's emotion processes documented across successive sessions as a developmental trajectory?
# Classes used: Student
# Properties used: hasEmotionProcess, hasTimestamp, occursDuring, partOfTrajectory
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?observation ?emotionLabel ?session ?date ?trajectory
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:hasEmotionProcess ?observation .
  ?observation rdfs:label ?emotionLabel .
  ?observation scon:occursDuring ?session .
  ?observation scon:hasTimestamp ?date .
  ?observation scon:partOfTrajectory ?trajectory .
}
ORDER BY ?student ?date
