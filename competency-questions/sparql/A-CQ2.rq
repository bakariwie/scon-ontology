# A-CQ2 (Academic domain)
# Competency question: Which academic indicators flag a student for Tier 2 targeted support, and from which data sources is each derived?
# Classes used: AcademicRiskIndicator, Student
# Properties used: assignedTier, documentedIn, hasRiskIndicator, tier2_targeted
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?indicator ?indicatorLabel ?source
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:assignedTier scon:tier2_targeted .
  ?student scon:hasRiskIndicator ?indicator .
  ?indicator rdf:type scon:AcademicRiskIndicator .
  ?indicator rdfs:label ?indicatorLabel .
  ?indicator scon:documentedIn ?source .
}
ORDER BY ?student
