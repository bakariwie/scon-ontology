# C-CQ3 (Career domain)
# Competency question: Which career clusters and occupations align with a student's assessed interests, aptitudes, and constraints?
# Classes used: PostsecondaryPlan, Student
# Properties used: alignsWithOccupation, belongsToCluster, hasGoal, hasONetSocCode
# NOTE: occupational alignment is recorded on the student's postsecondary
# plan rather than on the student directly, so the query routes through it.
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?plan ?occupation ?occupationLabel ?cluster ?socCode
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:hasGoal ?plan .
  ?plan rdf:type scon:PostsecondaryPlan .
  ?plan scon:alignsWithOccupation ?occupation .
  ?occupation rdfs:label ?occupationLabel .
  ?occupation scon:belongsToCluster ?cluster .
  OPTIONAL { ?occupation scon:hasONetSocCode ?socCode . }
}
ORDER BY ?student
