# S-CQ12 (Social-emotional domain)
# Competency question: Which self-management interventions reduce discipline incidents for the target group of a closing-the-gap action plan?
# Classes used: ClosingTheGapActionPlan, DisciplineReferral, SelfManagementIntervention, SocialEmotionalDevelopment
# Properties used: concernsStudent, recommendedFor, targetsDomain
# NOTE: the domain is matched by type rather than by naming the
# individual directly, so the query parses even where the ontology
# puns the domain name as both a class and an individual.
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?plan ?student ?intervention ?incident
WHERE {
  ?plan rdf:type scon:ClosingTheGapActionPlan .
  ?plan scon:targetsDomain ?domain .
  ?domain rdf:type scon:SocialEmotionalDevelopment .
  ?plan scon:concernsStudent ?student .
  ?intervention rdf:type scon:SelfManagementIntervention .
  ?intervention scon:recommendedFor ?student .
  OPTIONAL { ?incident rdf:type scon:DisciplineReferral .
             ?incident scon:concernsStudent ?student . }
}
ORDER BY ?student
