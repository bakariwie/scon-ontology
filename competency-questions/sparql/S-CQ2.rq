# S-CQ2 (Social-emotional domain)
# Competency question: Which behavioural and socio-emotional indicators flag a student for Tier 2 or Tier 3 support?
# Classes used: BehaviouralRiskIndicator, SocioEmotionalRiskIndicator, Student
# Properties used: assignedTier, documentedIn, hasRiskIndicator, tier2_targeted, tier3_intensive
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?tier ?indicator ?indicatorLabel ?source
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:assignedTier ?tier .
  FILTER (?tier = scon:tier2_targeted || ?tier = scon:tier3_intensive)
  ?student scon:hasRiskIndicator ?indicator .
  { ?indicator rdf:type scon:BehaviouralRiskIndicator . }
  UNION
  { ?indicator rdf:type scon:SocioEmotionalRiskIndicator . }
  ?indicator rdfs:label ?indicatorLabel .
  OPTIONAL { ?indicator scon:documentedIn ?source . }
}
ORDER BY ?tier ?student
