# C-CQ6 (Career domain)
# Competency question: How do a student's course selections map to a chosen career pathway and to its postsecondary entry requirements?
# Classes used: PostsecondaryPlan, Student
# Properties used: followsPathway, hasGoal, takesCourse
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?course ?plan ?pathway ?pathwayLabel
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:takesCourse ?course .
  ?student scon:hasGoal ?plan .
  ?plan rdf:type scon:PostsecondaryPlan .
  ?plan scon:followsPathway ?pathway .
  ?pathway rdfs:label ?pathwayLabel .
}
ORDER BY ?student ?course
