# C-CQ12 (Career domain)
# Competency question: Which employability behaviours, transferable across the Mindsets and Behaviors categories, evidence a student's career readiness?
# Classes used: MindsetsBehaviorsStandard, Student, WorkBasedLearning
# Properties used: addressesStandard, participatesInSession
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?experience ?standard ?standardLabel
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:participatesInSession ?experience .
  ?experience rdf:type scon:WorkBasedLearning .
  ?experience scon:addressesStandard ?standard .
  ?standard rdf:type scon:MindsetsBehaviorsStandard .
  ?standard rdfs:label ?standardLabel .
}
ORDER BY ?student
