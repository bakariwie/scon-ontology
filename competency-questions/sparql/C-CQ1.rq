# C-CQ1 (Career domain)
# Competency question: Which career-development Mindsets and Behaviors standards are addressed by the programme's Tier 1 career lessons at each grade level?
# Classes used: CareerDevelopment, ClassroomInstruction
# Properties used: addressesStandard, hasGradeLevel, targetsDomain
# NOTE: the domain is matched by type rather than by naming the
# individual directly, so the query parses even where the ontology
# puns the domain name as both a class and an individual.
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?lesson ?grade ?standard ?standardLabel
WHERE {
  ?lesson rdf:type scon:ClassroomInstruction .
  ?lesson scon:targetsDomain ?domain .
  ?domain rdf:type scon:CareerDevelopment .
  ?lesson scon:hasGradeLevel ?grade .
  ?lesson scon:addressesStandard ?standard .
  ?standard rdfs:label ?standardLabel .
}
ORDER BY ?grade
