# C-CQ2 (Career domain)
# Competency question: Which career assessments inform a student's postsecondary and career plan?
# Classes used: AssessmentInstrument, PostsecondaryPlan, Student
# Properties used: basedOnAssessment, hasGoal, hasScore
# Execute in the Protege Snap SPARQL tab AFTER running the HermiT reasoner:
# the query is answered over the inferred model, so derived types
# (AtRiskStudent, HighRiskStudent, RecommendedIntervention), inverse
# properties, transitive closures, and the hasStudentRiskLevel chain
# are all visible to it.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX scon: <http://www.semanticweb.org/bakariwie/ontologies/2026/6/scon-ontology-1#>

SELECT DISTINCT ?student ?plan ?assessment ?score
WHERE {
  ?student rdf:type scon:Student .
  ?student scon:hasGoal ?plan .
  ?plan rdf:type scon:PostsecondaryPlan .
  ?plan scon:basedOnAssessment ?assessment .
  ?assessment rdf:type scon:AssessmentInstrument .
  OPTIONAL { ?assessment scon:hasScore ?score . }
}
ORDER BY ?student
